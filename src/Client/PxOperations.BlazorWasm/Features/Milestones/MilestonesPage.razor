@page "/milestones"
@using PxOperations.Ui.Components.DataDisplay
@using PxOperations.Ui.Components.Navigation

<PageTitle>Marcos de Projeto · Operations PX</PageTitle>

<div class="page-header-bar">
    <BrqPageHeader Title="Marcos">
        <Actions>
            <button type="button" class="brq-button brq-button--sm brq-button--primary" @onclick="OpenCreateModal">+ Novo Marco</button>
        </Actions>
    </BrqPageHeader>
</div>

<MilestonesStatsBar
    TotalCount="@FilteredMilestones.Count"
    WeekCount="@ThisWeekCount"
    MonthCount="@ThisMonthCount"
    SponsorCount="@SponsorCount" />

<MilestonesToolbar
    DeliveryCenters="@deliveryCenters"
    ProjectTypes="@projectTypes"
    MilestoneTypes="@milestoneTypes"
    Projects="@projects"
    SearchTerm="@searchTerm"
    FilterDc="@filterDc"
    FilterProjectType="@filterProjectType"
    FilterType="@filterType"
    FilterProjectId="@filterProjectId"
    ActiveView="@activeView"
    TypeCss="@TypeCss"
    OnSearchTermChanged="@(value => searchTerm = value)"
    OnFilterDcChanged="@(value => filterDc = value)"
    OnFilterProjectTypeChanged="@(value => filterProjectType = value)"
    OnFilterTypeChanged="@(value => filterType = value)"
    OnFilterProjectIdChanged="@(value => filterProjectId = value)"
    OnViewChanged="@(value => activeView = value)" />

@if (isLoading)
{
    <div class="page-state"><BrqLoadingState AccessibleLabel="Carregando marcos" /></div>
}
else if (errorMessage is not null)
{
    <div class="page-state"><BrqErrorState Description="@errorMessage" OnRetry="LoadAsync" /></div>
}
else if (activeView == "semana")
{
    <MilestonesWeekView
        WeekDays="@WeekDays"
        WeekLabel="@WeekLabel"
        Today="@today"
        Culture="@portugueseCulture"
        GetItems="@WeekItems"
        TypeCss="@TypeCss"
        OnShiftWeek="ShiftWeek"
        OnGoToday="GoToday"
        OnOpenDetail="OpenDetail" />
}
else
{
    <MilestonesMonthView
        CalendarDays="@CalendarDays"
        CurrentMonth="@currentMonth"
        Today="@today"
        MonthLabel="@MonthLabel"
        GetItems="@CalendarItems"
        TypeCss="@TypeCss"
        OnShiftMonth="ShiftMonth"
        OnOpenDetail="OpenDetail" />
}

@if (selectedMilestone is not null)
{
    <MilestoneDetailModal
        Milestone="@selectedMilestone"
        OnClose="CloseDetail"
        OnEdit="EditSelected"
        OnDelete="DeleteSelectedAsync" />
}

@if (showModal)
{
    <MilestoneFormModal
        Projects="@projects"
        EditingMilestone="@editingMilestone"
        OnClose="@CloseModal"
        OnSaved="@HandleSavedAsync" />
}

<div class="toast @(toastMessage is not null ? "show" : "")">
    <span>@toastMessage</span>
</div>
