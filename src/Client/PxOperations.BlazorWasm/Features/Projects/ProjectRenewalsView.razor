@using PxOperations.BlazorWasm.Api
@using PxOperations.Ui.Components.DataDisplay

<div class="renewals-view">
    <section class="renewals-summary" aria-labelledby="renewals-summary-title">
        <div class="renewals-summary__coverage">
            <span class="renewals-summary__eyebrow" id="renewals-summary-title">Cobertura de renovações</span>
            <strong>@CoveragePct%</strong>
            <span>@PeriodLabel @Year</span>
            <div class="renewals-summary__track" role="progressbar" aria-valuenow="@CoveragePct" aria-valuemin="0" aria-valuemax="100" aria-label="Cobertura de renovações">
                <span style="width: @(CoveragePct)%"></span>
            </div>
        </div>
        <div class="renewals-summary__breakdown" aria-label="Resumo por status">
            <div><strong>@Approved</strong><span>Aprovadas</span></div>
            <div><strong>@InProgress</strong><span>Em andamento</span></div>
            <div><strong>@Pending</strong><span>Pendentes</span></div>
            <div><strong>@NoStatus</strong><span>Sem status</span></div>
        </div>
    </section>

    @if (ShowDcBars)
    {
        <section class="renewals-section" aria-labelledby="renewals-dc-title">
            <div class="renewals-section__head">
                <h2 id="renewals-dc-title">Cobertura por Delivery Center</h2>
                <span>@PeriodLabel @Year</span>
            </div>
            <div class="renewals-dc-grid">
                @foreach (var bar in DcBars.Where(item => item.Total > 0))
                {
                    <article class="renewals-dc-card">
                        <div class="renewals-dc-card__head"><strong>@bar.Dc</strong><span>@bar.Pct%</span></div>
                        <div class="renewals-dc-card__track"><span style="width: @(bar.Pct)%"></span></div>
                        <span>@bar.WithStatus/@bar.Total com status · @bar.Approved aprovada@(bar.Approved != 1 ? "s" : "")</span>
                    </article>
                }
            </div>
        </section>
    }

    <section class="renewals-section" aria-labelledby="renewals-projects-title">
        <div class="renewals-section__head">
            <h2 id="renewals-projects-title">Projetos com renovação registrada</h2>
            <span>@Cards.Count projetos</span>
        </div>
        @if (Cards.Any())
        {
            <div class="renewals-cards">
                @foreach (var project in Cards)
                {
                    <article class="renewal-card" tabindex="0" role="button" @onclick="() => OnEdit.InvokeAsync(project.Id)" @onkeydown="@(args => args.Key == "Enter" ? OnEdit.InvokeAsync(project.Id) : Task.CompletedTask)">
                        <div class="renewal-card__body">
                            <h3>@project.Name</h3>
                            <p>@(project.Client ?? "—") · @project.Dc · @(project.DeliveryManager ?? "—")</p>
                            @if (!string.IsNullOrWhiteSpace(project.RenewalObservation))
                            {
                                <span>@project.RenewalObservation</span>
                            }
                        </div>
                        <div class="renewal-card__meta">
                            <BrqTag Label="@ProjectBadgeHelper.GetRenewalLabel(project.Renewal)" Tone="@ProjectBadgeHelper.GetRenewalTagTone(project.Renewal)" Size="BrqSize.Small" />
                            <time datetime="@project.EndDate">@ProjectBadgeHelper.FormatDate(project.EndDate)</time>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="renewals-empty">Nenhuma renovação registrada para este período.</div>
        }
    </section>
</div>
