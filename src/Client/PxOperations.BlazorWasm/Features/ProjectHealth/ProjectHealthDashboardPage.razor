@page "/project-health"
@using PxOperations.BlazorWasm.Api
@using PxOperations.Ui.Components.DataDisplay
@using PxOperations.Ui.Components.Navigation

<div class="page-header-bar">
    <BrqPageHeader Title="Saúde de Projetos">
        <Actions>
            <a class="brq-button brq-button--secondary" href="/project-health/new">↗ Formulário do Líder</a>
        </Actions>
    </BrqPageHeader>
</div>

<ProjectHealthStatsBar TotalProjects="@summary?.TotalProjects"
                AverageScore="@summary?.OverallAverageScore"
                CriticalCount="@summary?.OverallCriticalCount"
                NoResponseCount="@summary?.OverallNoResponseCount" />

<ProjectHealthToolbar SearchTerm="@searchTerm" OnSearchChanged="OnSearchChanged"
               FilterDc="@filterDc" OnFilterDcChanged="OnFilterDcChanged"
               ProjectTypes="@projectTypes" FilterProjectType="@filterProjectType" OnFilterProjectTypeChanged="OnFilterProjectTypeChanged"
               FilterWeek="@filterWeek" OnFilterWeekChanged="OnFilterWeekChanged" AvailableWeeks="@availableWeeks"
               FilterScore="@filterScore" OnFilterScoreChanged="OnFilterScoreChanged"
               ActiveTab="@activeTab" OnTabChanged="OnTabChanged" />

@if (isLoading)
{
    <div class="page-state"><BrqLoadingState AccessibleLabel="Carregando saúde dos projetos" /></div>
}
else if (loadError is not null)
{
    <div class="page-state"><BrqErrorState Description="@loadError" OnRetry="LoadDataAsync" /></div>
}
else if (activeTab == "dash")
{
    <ProjectHealthDashboardView Summary="@summary" Entries="@FilteredEntries" OnCardClick="OpenDetailModal" />
}
else
{
    <ProjectHealthProjectsView Entries="@FilteredEntries" OnCardClick="OpenDetailModal" />
}

@if (showDetailModal && detailEntry is not null)
{
    <ProjectHealthDetailModal Entry="@detailEntry" OnClose="CloseDetailModal" />
}
