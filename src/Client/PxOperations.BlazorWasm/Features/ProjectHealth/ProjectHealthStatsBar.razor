@using PxOperations.Ui.Components.DataDisplay

<div class="page-kpis">
    <BrqKpiBar Label="Indicadores de saúde">
        <BrqKpiCard Label="Projetos" Value="@(TotalProjects?.ToString() ?? "—")" />
        <BrqKpiCard Label="Média / 10" Value="@(AverageScore?.ToString("0.0") ?? "—")" />
        <BrqKpiCard Label="Críticos" Value="@(CriticalCount?.ToString() ?? "—")" />
        <BrqKpiCard Label="Sem resp" Value="@(NoResponseCount?.ToString() ?? "—")" />
    </BrqKpiBar>
</div>
