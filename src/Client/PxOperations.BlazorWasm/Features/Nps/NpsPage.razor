@page "/nps"
@page "/nps/coleta"
@page "/nps/resultados"
@page "/nps/respostas"
@using PxOperations.Ui.Components.DataDisplay
@using PxOperations.Ui.Components.Forms
@using PxOperations.Ui.Components.Overlays

<PageTitle>NPS · Operations PX</PageTitle>

<section class="nps-page">
    <header class="page-actions-bar nps-page-header">
        <div class="nps-page-title">
            <h1>NPS</h1>
            <p>Coleta e leitura do relacionamento com clientes.</p>
        </div>
        <div class="nps-page-actions">
            <a class="btn btn-ghost" href="@ExportHref">Exportar CSV</a>
            <button type="button" class="btn btn-purple" @onclick="OpenCreateDialog">Gerar link</button>
        </div>
    </header>

    @if (ShowsIndicators)
    {
        <NpsStatsBar OfficialNps="@dashboard?.OfficialNps"
                    TotalResponses="@(dashboard?.TotalResponses)"
                    AverageScore="@dashboard?.AverageScore"
                    OverdueProjects="@(dashboard?.OverdueProjects)" />
    }

    <NpsToolbar ShowsFilters="@ShowsFilters"
                ActiveTab="@ActiveTab"
                FilterOptions="@FilterOptions"
                Search="@search"
                SearchPlaceholder="@SearchPlaceholder"
                OnSearchInput="SearchChanged"
                ActiveFacetCount="@ActiveFacetCount"
                OnClear="ClearFiltersAsync"
                Clients="@clients"
                Dcs="@dcs"
                ProjectTypes="@projectTypes"
                DeliveryManagers="@deliveryManagers"
                Statuses="@statuses"
                Formats="@formats"
                Classifications="@classifications"
                OnToggleFacet="ToggleFacetAsync"
                IncludeWaived="@includeWaived"
                OnToggleWaived="ToggleWaivedAsync"
                From="@from"
                To="@to"
                OnFromChanged="FromChangedAsync"
                OnToChanged="ToChangedAsync"
                CollectionHref="@TabHref("coleta")"
                ResultsHref="@TabHref("resultados")"
                ResponsesHref="@TabHref("respostas")"
                OnTabChange="ChangeTabAsync" />

    @if (ShowsFilters)
    {
        @if (ActiveChips.Count != 0)
        {
            <div class="nps-filter-chips">
                @foreach (var chip in ActiveChips)
                {
                    <button type="button" class="nps-filter-chip" @onclick="() => RemoveFacetAsync(chip.Key)">
                        <strong>@chip.Label:</strong> @chip.Values <span aria-hidden="true">×</span>
                    </button>
                }
            </div>
        }
    }

    <div class="nps-content">
        @if (actionError is not null && !createDialogOpen && !waiverDialogOpen && !detailDialogOpen)
        {
            <div class="status-card error nps-load-error" role="alert"><p>@actionError</p></div>
        }

        @if (ActiveTab == NpsTab.Collection)
        {
            <NpsCollectionBoard Projects="@projects"
                                IsLoading="@isLoading"
                                LoadError="@loadError"
                                OnReload="ReloadAsync"
                                IncludeWaived="@includeWaived"
                                OnPrimaryAction="RunPrimaryActionAsync"
                                OnOpenDetail="OpenDetailAsync"
                                OnOpenWaiver="OpenWaiverDialog"
                                OnReactivate="ReactivateAsync" />
        }
        else if (ActiveTab == NpsTab.Results)
        {
            <NpsResultsView @ref="resultsView"
                            Dashboard="@dashboard"
                            Results="@projectResults"
                            IsLoading="@isLoading"
                            LoadError="@loadError"
                            OnReload="ReloadAsync"
                            From="@from"
                            To="@to" />
        }
        else if (ActiveTab == NpsTab.Responses)
        {
            @if (isLoading)
            {
                <p class="nps-loading" role="status">Atualizando respostas…</p>
            }
            @if (loadError is not null)
            {
                <div class="status-card error nps-load-error"><p>@loadError</p><button type="button" class="btn btn-purple" @onclick="ReloadAsync">Tentar novamente</button></div>
            }
            else if (!isLoading && responseAudit.Count == 0)
            {
                <div class="nps-empty-delivery"><BrqEmptyState Title="Nenhuma resposta" Description="Ajuste os filtros ou aguarde uma nova coleta." /></div>
            }
            else
            {
                <section class="nps-responses-table" aria-busy="@isLoading">
                    <BrqTableShell Caption="Auditoria de respostas NPS">
                        <thead>
                            <tr><th scope="col">Projeto</th><th scope="col">Nota</th><th scope="col">Classificação</th><th scope="col">Formato</th><th scope="col">Autor</th><th scope="col">Comentário</th><th scope="col">Recebida</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var response in responseAudit)
                            {
                                <tr class="nps-response-row"
                                    tabindex="0"
                                    aria-label="@($"Abrir resposta de {response.ProjectName}")"
                                    @onclick="() => OpenResponseDialog(response)"
                                    @onkeydown="args => ResponseRowKeyDown(args, response)">
                                    <td class="data-table__cell-strong"><button type="button" class="nps-response-project" @onclick:stopPropagation="true" @onclick="() => OpenResponseDialog(response)">@response.ProjectName</button></td>
                                    <td><strong class="nps-response-score">@response.Score</strong></td>
                                    <td><BrqStatusPill Label="@response.ClassificationLabel" Tone="@NpsTone.From(response.ClassificationTone)" Size="BrqSize.Small" /></td>
                                    <td>@response.FormatLabel</td>
                                    <td class="nps-response-author"><span>@ResponseAuthorName(response)</span>@if (ResponseAuthorDetail(response) is { } detail) { <small>@detail</small> }</td>
                                    <td><span class="nps-response-comment" title="@response.Comment">@(response.Comment ?? "Sem comentário")</span></td>
                                    <td><time datetime='@response.SubmittedAt.ToString("O")'>@NpsTimeDisplay.DateAndTime(response.SubmittedAt)</time></td>
                                </tr>
                            }
                        </tbody>
                    </BrqTableShell>
                </section>
            }
        }
    </div>
</section>

<BrqDialog @bind-Open="createDialogOpen"
           Title="Gerar link NPS"
           Description="@CreateDialogDescription"
           CssClass="nps-dialog"
           AutofocusSelector=".nps-create-project">
    <ChildContent>
        @if (createdDispatch is null)
        {
            <div class="nps-create-form">
                <div class="nps-dialog-step">
                    <span>1</span>
                    <div><strong>Projeto, formato e idioma</strong><p>Defina como a rodada será compartilhada.</p></div>
                </div>
                <div class="nps-form-grid">
                    <label class="nps-field nps-field-full">
                        <span>Projeto</span>
                        <select class="nps-create-project" @bind="createProjectId">
                            <option value="0">Selecione o projeto</option>
                            @foreach (var project in projects.Where(project => project.Stage.Code != "waived"))
                            {
                                <option value="@project.Id">@project.Name</option>
                            }
                        </select>
                    </label>
                    <label class="nps-field">
                        <span>Formato</span>
                        <select @bind="createFormat"><option value="complete">Completo</option><option value="simplified">Simplificado</option></select>
                    </label>
                    <label class="nps-field">
                        <span>Idioma</span>
                        <select @bind="createLanguage"><option value="pt">Português</option><option value="en">Inglês</option><option value="es">Espanhol</option></select>
                    </label>
                </div>
            </div>
        }
        else
        {
            var target = createdDispatch.Targets.Single(target => target.IsGeneric);
            <div class="nps-created-link">
                <div class="nps-dialog-step complete">
                    <span>2</span>
                    <div><strong>Link pronto · @createdDispatch.Dispatch.FormatLabel</strong><p>Compartilhe o link ou a mensagem sugerida.</p></div>
                </div>
                <label class="nps-created-block">
                    <span>Link</span>
                    <input readonly value="@PublicUrl(target.Token)" />
                </label>
                <div class="nps-created-block nps-created-validity">
                    <span>Validade</span>
                    <strong>@NpsTimeDisplay.Date(createdDispatch.Dispatch.ExpiresAt)</strong>
                </div>
                <label class="nps-created-block">
                    <span>Mensagem sugerida</span>
                    <textarea readonly>@SuggestedMessage</textarea>
                </label>
            </div>
        }

        @if (actionError is not null)
        {
            <p class="nps-action-error" role="alert">@actionError</p>
        }
    </ChildContent>
    <Footer>
        @if (createdDispatch is null)
        {
            <button type="button" class="btn btn-ghost" @onclick="CloseCreateDialog">Cancelar</button>
            <button type="button" class="btn btn-purple nps-create-submit" disabled="@(createProjectId == 0)" @onclick="CreateDispatchAsync">Gerar link</button>
        }
        else
        {
            <button type="button" class="btn btn-ghost" @onclick="() => CopyAsync(PublicUrl(createdDispatch.Targets.Single(target => target.IsGeneric).Token))">Copiar link</button>
            <button type="button" class="btn btn-purple" @onclick="() => CopyAsync(SuggestedMessage)">Copiar mensagem</button>
        }
    </Footer>
</BrqDialog>

<BrqDialog @bind-Open="responseDialogOpen"
           Title="Resposta NPS"
           Description="@selectedResponse?.ProjectName"
           CssClass="nps-dialog nps-response-dialog">
    <ChildContent>
        @if (selectedResponse is not null)
        {
            <section class="nps-response-overview">
                <div><span>Nota</span><strong>@selectedResponse.Score</strong></div>
                <div><span>Classificação</span><strong>@selectedResponse.ClassificationLabel</strong></div>
                <div><span>Formato</span><strong>@selectedResponse.FormatLabel</strong></div>
                <div><span>Recebida</span><strong>@NpsTimeDisplay.DateAndTime(selectedResponse.SubmittedAt)</strong></div>
            </section>
            <section class="nps-response-attribution">
                <h3>Atribuição</h3>
                <strong>@ResponseAuthorName(selectedResponse)</strong>
                @if (ResponseAuthorDetail(selectedResponse) is { } detail)
                {
                    <span>@detail</span>
                }
            </section>
            <section class="nps-response-full-comment">
                <h3>Comentário</h3>
                <p>@(selectedResponse.Comment ?? "Sem comentário")</p>
            </section>
            @if (selectedResponse.Format == "complete")
            {
                <section class="nps-response-aspects">
                    <header><h3>Aspectos</h3><span>Média dos aspectos <strong>@ResponseAspectAverage(selectedResponse)</strong></span></header>
                    <dl>
                        <div class="nps-response-aspect"><dt>Qualidade</dt><dd>@(selectedResponse.Quality?.ToString() ?? "—")</dd></div>
                        <div class="nps-response-aspect"><dt>Prazo</dt><dd>@(selectedResponse.Schedule?.ToString() ?? "—")</dd></div>
                        <div class="nps-response-aspect"><dt>Comunicação</dt><dd>@(selectedResponse.Communication?.ToString() ?? "—")</dd></div>
                        <div class="nps-response-aspect"><dt>Valor para o negócio</dt><dd>@(selectedResponse.BusinessValue?.ToString() ?? "—")</dd></div>
                    </dl>
                </section>
            }
        }
    </ChildContent>
    <Footer><button type="button" class="btn btn-ghost" @onclick="CloseResponseDialog">Fechar</button></Footer>
</BrqDialog>

<BrqDialog @bind-Open="detailDialogOpen" Title="Detalhe da coleta" Description="@selectedDetail?.Project.Name" CssClass="nps-dialog nps-detail-dialog">
    <ChildContent>
        @if (actionError is not null)
        {
            <p class="nps-action-error" role="alert">@actionError</p>
        }

        @if (selectedDetail is not null)
        {
            <section class="nps-detail-kpis" aria-label="Indicadores da coleta">
                <article class="nps-detail-kpi"><span>NPS</span><strong>@NpsDisplay.Metric(selectedDetail.OfficialNps)</strong></article>
                <article class="nps-detail-kpi"><span>Respostas</span><strong>@selectedDetail.ResponsesCount</strong></article>
                <article class="nps-detail-kpi"><span>Média</span><strong>@NpsDisplay.Metric(selectedDetail.AverageScore)</strong></article>
                <article class="nps-detail-kpi"><span>Promotores</span><strong>@selectedDetail.PromotersCount</strong></article>
            </section>
            <section class="nps-detail-links">
                <h3>Links ativos</h3>
                @if (selectedDetail.ActiveLinks.Count == 0)
                {
                    <p class="nps-detail-empty">Nenhum link ativo.</p>
                }
                else
                {
                    @foreach (var link in selectedDetail.ActiveLinks)
                    {
                        <article>
                            <span><small>Formato</small><strong>@link.FormatLabel</strong></span>
                            <span><small>Status</small><strong>@link.AvailabilityLabel</strong></span>
                            <span><small>Validade</small><strong>@NpsTimeDisplay.Date(link.ExpiresAt)</strong></span>
                        </article>
                    }
                }
            </section>
            <section class="nps-detail-responses">
                <header>
                    <h3>Respostas recentes</h3>
                    <div class="nps-detail-format-filter" aria-label="Filtrar respostas por formato">
                        <button type="button" class="nps-detail-segment @(detailFormat == "all" ? "active" : null)" data-format="all" aria-pressed="@((detailFormat == "all").ToString().ToLowerInvariant())" @onclick="FilterAllDetailResponsesAsync">Todos</button>
                        <button type="button" class="nps-detail-segment @(detailFormat == "complete" ? "active" : null)" data-format="complete" aria-pressed="@((detailFormat == "complete").ToString().ToLowerInvariant())" @onclick="FilterCompleteDetailResponsesAsync">Completo</button>
                        <button type="button" class="nps-detail-segment @(detailFormat == "simplified" ? "active" : null)" data-format="simplified" aria-pressed="@((detailFormat == "simplified").ToString().ToLowerInvariant())" @onclick="FilterSimplifiedDetailResponsesAsync">Simplificado</button>
                    </div>
                </header>
                @if (detailResponses.Count == 0)
                {
                    <p class="nps-detail-empty">Nenhuma resposta neste formato.</p>
                }
                else
                {
                    <ul class="nps-recent-responses">
                        @foreach (var response in detailResponses)
                        {
                            <li><strong>@response.Score · @response.ClassificationLabel</strong><span>@(response.Comment ?? "Sem comentário")</span></li>
                        }
                    </ul>
                }
            </section>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseDetailDialog">Fechar</button>
    </Footer>
</BrqDialog>

<BrqDialog @bind-Open="waiverDialogOpen"
           Title="Dispensar coleta"
           Description="A dispensa é reversível e fecha os links abertos."
           CssClass="nps-dialog"
           AutofocusSelector=".nps-waiver-reason">
    <ChildContent>
        <label class="nps-field">
            <span>Motivo da dispensa</span>
            <textarea class="nps-waiver-reason" @bind="waiverReason" maxlength="500" placeholder="Explique por que este projeto não participará desta coleta"></textarea>
        </label>

        @if (actionError is not null)
        {
            <p class="nps-action-error" role="alert">@actionError</p>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost nps-waiver-cancel" @onclick="CloseWaiverDialog">Cancelar</button>
        <button type="button" class="btn btn-purple nps-waiver-confirm" disabled="@string.IsNullOrWhiteSpace(waiverReason)" @onclick="WaiveAsync">Confirmar dispensa</button>
    </Footer>
</BrqDialog>
