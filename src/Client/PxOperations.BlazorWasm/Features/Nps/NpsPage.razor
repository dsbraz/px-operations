@page "/nps"
@page "/nps/coleta"
@page "/nps/resultados"
@page "/nps/respostas"
@using PxOperations.Ui.Components.DataDisplay
@using PxOperations.Ui.Components.Forms
@using PxOperations.Ui.Components.Overlays

<PageTitle>NPS · Operations PX</PageTitle>

<section class="nps-page">
    <header class="page-actions-bar nps-page-header">
        <div class="nps-page-title">
            <h1>NPS</h1>
            <p>Coleta e leitura do relacionamento com clientes.</p>
        </div>
        <div class="nps-page-actions">
            <a class="btn btn-ghost" href="@ExportHref">Exportar CSV</a>
            <button type="button" class="btn btn-purple" @onclick="OpenCreateDialog">Gerar link</button>
        </div>
    </header>

    @if (ShowsIndicators)
    {
        <section class="stats-bar nps-indicators" aria-label="Indicadores do NPS">
            <div class="stat p">
                <div class="sico p" aria-hidden="true">◈</div>
                <div><div class="sval">@DisplayMetric(dashboard?.OfficialNps)</div><div class="slbl">NPS oficial</div></div>
            </div>
            <div class="stat g">
                <div class="sico g" aria-hidden="true">✓</div>
                <div><div class="sval">@(dashboard is null ? "—" : dashboard.TotalResponses.ToString())</div><div class="slbl">Respostas</div></div>
            </div>
            <div class="stat b">
                <div class="sico b" aria-hidden="true">◎</div>
                <div><div class="sval">@DisplayMetric(dashboard?.AverageScore)</div><div class="slbl">Média</div></div>
            </div>
            <div class="stat o">
                <div class="sico o" aria-hidden="true">!</div>
                <div><div class="sval">@(dashboard is null ? "—" : dashboard.OverdueProjects.ToString())</div><div class="slbl">Vencidos</div></div>
            </div>
        </section>
    }

    <div class="toolbar nps-toolbar">
        @if (ShowsFilters)
        {
            <div class="search-wrap nps-search">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8" />
                    <path d="M21 21l-4.35-4.35" />
                </svg>
                <input value="@search" @oninput="SearchChanged" placeholder="@(ActiveTab == NpsTab.Responses ? "Buscar projeto, pessoa ou comentário" : "Buscar projeto ou cliente")" />
            </div>
            <BrqFilterPanel ActiveFacetCount="@ActiveFacetCount" OnClear="ClearFiltersAsync">
                <fieldset>
                    <legend>Cliente</legend>
                    @foreach (var option in FilterOptions.Clients)
                    {
                        <label><input type="checkbox" checked="@clients.Contains(option.Code)" @onchange="() => ToggleFacetAsync(clients, option.Code)" />@option.Label</label>
                    }
                </fieldset>
                <fieldset>
                    <legend>DC</legend>
                    @foreach (var option in FilterOptions.Dcs)
                    {
                        <label><input type="checkbox" checked="@dcs.Contains(option.Code)" @onchange="() => ToggleFacetAsync(dcs, option.Code)" />@option.Label</label>
                    }
                </fieldset>
                <fieldset>
                    <legend>Tipo</legend>
                    @foreach (var option in FilterOptions.ProjectTypes)
                    {
                        <label><input type="checkbox" checked="@projectTypes.Contains(option.Code)" @onchange="() => ToggleFacetAsync(projectTypes, option.Code)" />@option.Label</label>
                    }
                </fieldset>
                <fieldset>
                    <legend>Delivery Manager</legend>
                    @foreach (var option in FilterOptions.DeliveryManagers)
                    {
                        <label><input type="checkbox" checked="@deliveryManagers.Contains(option.Code)" @onchange="() => ToggleFacetAsync(deliveryManagers, option.Code)" />@option.Label</label>
                    }
                </fieldset>
                @if (ActiveTab == NpsTab.Collection)
                {
                    <fieldset>
                        <legend>Dispensados</legend>
                        <label><input type="checkbox" checked="@includeWaived" @onchange="ToggleWaivedAsync" />Mostrar dispensados</label>
                    </fieldset>
                }
                @if (ActiveTab == NpsTab.Results)
                {
                    <fieldset>
                        <legend>Status</legend>
                        @foreach (var option in FilterOptions.Statuses)
                        {
                            <label><input type="checkbox" checked="@statuses.Contains(option.Code)" @onchange="() => ToggleFacetAsync(statuses, option.Code)" />@option.Label</label>
                        }
                    </fieldset>
                    <fieldset>
                        <legend>Data da coleta</legend>
                        <label>De <input type="date" value="@from" @onchange="FromChangedAsync" /></label>
                        <label>Até <input type="date" value="@to" @onchange="ToChangedAsync" /></label>
                    </fieldset>
                }
                @if (ActiveTab == NpsTab.Responses)
                {
                    <fieldset>
                        <legend>Formato</legend>
                        @foreach (var option in FilterOptions.Formats)
                        {
                            <label><input type="checkbox" checked="@formats.Contains(option.Code)" @onchange="() => ToggleFacetAsync(formats, option.Code)" />@option.Label</label>
                        }
                    </fieldset>
                    <fieldset>
                        <legend>Classificação</legend>
                        @foreach (var option in FilterOptions.Classifications)
                        {
                            <label><input type="checkbox" checked="@classifications.Contains(option.Code)" @onchange="() => ToggleFacetAsync(classifications, option.Code)" />@option.Label</label>
                        }
                    </fieldset>
                    <fieldset>
                        <legend>Recebida em</legend>
                        <label>De <input type="date" value="@from" @onchange="FromChangedAsync" /></label>
                        <label>Até <input type="date" value="@to" @onchange="ToChangedAsync" /></label>
                    </fieldset>
                }
            </BrqFilterPanel>
        }

        <nav class="view-tabs" aria-label="Visões do NPS">
            <a class="vtab @(ActiveTab == NpsTab.Collection ? "active" : null)" href="@TabHref("coleta")" @onclick="() => ChangeTabAsync(NpsTab.Collection)" @onclick:preventDefault="true">Coleta</a>
            <a class="vtab @(ActiveTab == NpsTab.Results ? "active" : null)" href="@TabHref("resultados")" @onclick="() => ChangeTabAsync(NpsTab.Results)" @onclick:preventDefault="true">Resultados</a>
            <a class="vtab @(ActiveTab == NpsTab.Responses ? "active" : null)" href="@TabHref("respostas")" @onclick="() => ChangeTabAsync(NpsTab.Responses)" @onclick:preventDefault="true">Respostas</a>
        </nav>
    </div>

    @if (ShowsFilters)
    {
        @if (ActiveChips.Count != 0)
        {
            <div class="nps-filter-chips">
                @foreach (var chip in ActiveChips)
                {
                    <button type="button" class="nps-filter-chip" @onclick="() => RemoveFacetAsync(chip.Key)">
                        <strong>@chip.Label:</strong> @chip.Values <span aria-hidden="true">×</span>
                    </button>
                }
            </div>
        }
    }

    <div class="nps-content">
        @if (actionError is not null && !createDialogOpen && !waiverDialogOpen && !detailDialogOpen)
        {
            <div class="status-card error nps-load-error" role="alert"><p>@actionError</p></div>
        }

        @if (ActiveTab == NpsTab.Collection)
        {
            @if (isLoading)
            {
                <p class="nps-loading" role="status">Atualizando quadro…</p>
            }
            @if (loadError is not null)
            {
                <div class="status-card error nps-load-error">
                    <p>@loadError</p>
                    <button type="button" class="btn btn-purple" @onclick="ReloadAsync">Tentar novamente</button>
                </div>
            }

            <div class="kanban-board nps-board" aria-busy="@isLoading">
                @foreach (var column in BoardColumns)
                {
                    var stageProjects = ProjectsForStage(column.Code);
                    <section class="kanban-column nps-board-column @column.ColorClass" data-stage="@column.Code">
                        <header class="kanban-col-header">
                            <h2 class="kanban-col-title">@column.Label</h2>
                            <span class="kanban-col-count">@stageProjects.Count</span>
                        </header>
                        <div class="kanban-col-body nps-card-list">
                            @if (stageProjects.Count == 0)
                            {
                                <div class="kanban-empty">Nenhum projeto nesta etapa</div>
                            }
                            else
                            {
                                @foreach (var project in stageProjects)
                                {
                                    <article class="kanban-card nps-project-card">
                                        <div class="nps-card-heading">
                                            <div>
                                                <h3 class="kanban-card-name">@project.Name</h3>
                                                <p class="kanban-card-meta">@project.Client · @project.Dc</p>
                                            </div>
                                            <BrqStatusPill Label="@project.Stage.Label" Tone="@Tone(project.Stage.Tone)" Size="BrqSize.Small" />
                                        </div>
                                        <div class="nps-temporal">
                                            <BrqStatusPill Label="@project.Temporal.Label" Tone="@Tone(project.Temporal.Tone)" Size="BrqSize.Small" />
                                        </div>
                                        <dl>
                                            <div><dt>Delivery Manager</dt><dd>@(project.DeliveryManager ?? "—")</dd></div>
                                            <div><dt>Respostas</dt><dd>@project.ResponsesCount</dd></div>
                                        </dl>
                                        @if (project.ActiveLinks.Count != 0)
                                        {
                                            <ul class="nps-card-links">
                                                @foreach (var link in project.ActiveLinks)
                                                {
                                                    <li><strong>@link.FormatLabel</strong><span>@link.AvailabilityLabel · até @NpsTimeDisplay.Date(link.ExpiresAt)</span></li>
                                                }
                                            </ul>
                                        }
                                        <div class="nps-card-actions">
                                            @if (project.PrimaryAction is not null)
                                            {
                                                <button type="button" class="btn btn-purple nps-primary-action" @onclick="() => RunPrimaryActionAsync(project)">@project.PrimaryAction.Label</button>
                                            }
                                            <button type="button"
                                                    class="ibtn nps-card-icon-action"
                                                    title="Ver detalhe"
                                                    aria-label="Ver detalhe de @project.Name"
                                                    @onclick="() => OpenDetailAsync(project.Id)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                                                    <circle cx="12" cy="12" r="2.5" />
                                                </svg>
                                            </button>
                                            <button type="button"
                                                    class="ibtn nps-card-icon-action del"
                                                    title="Dispensar coleta"
                                                    aria-label="Dispensar coleta de @project.Name"
                                                    @onclick="() => OpenWaiverDialog(project.Id)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                    <circle cx="12" cy="12" r="8.5" />
                                                    <path d="m6 6 12 12" />
                                                </svg>
                                            </button>
                                        </div>
                                    </article>
                                }
                            }
                        </div>
                    </section>
                }
            </div>

            @if (includeWaived)
            {
                <section class="nps-waived-section">
                    <h2>Dispensados</h2>
                    <div class="nps-waived-grid">
                        @foreach (var project in WaivedProjects)
                        {
                            <article class="nps-project-card">
                                <h3>@project.Name</h3>
                                <p>@project.Waiver?.Reason</p>
                                <BrqStatusPill Label="@project.Temporal.Label" Tone="BrqStatusTone.Neutral" Size="BrqSize.Small" />
                                <button type="button" class="btn btn-purple" @onclick="() => ReactivateAsync(project.Id)">Reativar</button>
                            </article>
                        }
                    </div>
                </section>
            }
        }
        else if (ActiveTab == NpsTab.Results)
        {
            @if (loadError is not null)
            {
                <div class="status-card error nps-load-error"><p>@loadError</p><button type="button" class="btn btn-purple" @onclick="ReloadAsync">Tentar novamente</button></div>
            }
            else if (dashboard is not null)
            {
                <div class="nps-executive-panels">
                    <section class="nps-results" aria-busy="@isLoading">
                        <header class="nps-results-header">
                            <div>
                                <h2>Distribuição das respostas</h2>
                                <p>Composição executiva da nota oficial do período.</p>
                            </div>
                            <p class="nps-formula">NPS = % promotores − % detratores</p>
                        </header>
                        <div class="nps-distribution-bar" aria-label="Distribuição das classificações">
                            @foreach (var item in dashboard.Distribution)
                            {
                                <span class="@($"tone-{item.Tone}")" style="@BarWidth(item.Percentage)"></span>
                            }
                        </div>
                        <ul class="nps-distribution-legend">
                            @foreach (var item in dashboard.Distribution)
                            {
                                <li>
                                    <span class="nps-legend-label"><span class="nps-legend-swatch @($"tone-{item.Tone}")" aria-hidden="true"></span><strong>@item.Label</strong></span>
                                    <span>@item.Count · @item.Percentage.ToString("0.0")%</span>
                                </li>
                            }
                        </ul>
                    </section>

                    <section class="nps-aspect-summary" aria-labelledby="nps-aspect-summary-title">
                        <header class="nps-aspect-header">
                            <h2 id="nps-aspect-summary-title">Médias por aspecto</h2>
                            <p>@dashboard.AspectSummary.CompleteResponsesCount respostas Completas · escala @dashboard.AspectSummary.Scale.Minimum–@dashboard.AspectSummary.Scale.Maximum</p>
                        </header>
                        @if (dashboard.AspectSummary.CompleteResponsesCount == 0)
                        {
                            <p class="nps-aspect-empty">Nenhuma resposta Completa no recorte atual.</p>
                        }
                        else
                        {
                            <ul class="nps-aspect-list">
                                @foreach (var aspect in dashboard.AspectSummary.Aspects)
                                {
                                    <li class="nps-aspect-row" data-aspect="@aspect.Code">
                                        <div class="nps-aspect-row-header">
                                            <strong class="nps-aspect-label">@aspect.Label</strong>
                                            <span class="nps-aspect-value">
                                                <span class="nps-aspect-average">@DisplayAspectAverage(aspect.Average)</span>
                                                <span class="nps-aspect-count">n=@aspect.ResponsesCount</span>
                                            </span>
                                        </div>
                                        @if (aspect.Average.HasValue)
                                        {
                                            <meter min="@dashboard.AspectSummary.Scale.Minimum"
                                                   max="@dashboard.AspectSummary.Scale.Maximum"
                                                   value="@AspectMeterValue(aspect.Average.Value)"
                                                   aria-label="@AspectMeterLabel(aspect, dashboard.AspectSummary.Scale.Maximum)">
                                                @DisplayAspectAverage(aspect.Average) de @dashboard.AspectSummary.Scale.Maximum
                                            </meter>
                                        }
                                        else
                                        {
                                            <span class="nps-aspect-meter-empty" role="img" aria-label="Sem respostas para @aspect.Label"></span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                </div>

                <section class="nps-results-table" aria-label="Resultados por projeto" @onkeydown="ResultsKeyDown">
                    <BrqTableShell Caption="Resultados NPS por projeto">
                        <thead>
                            <tr>
                                <th scope="col" data-column="project" aria-sort='@AriaSort("project")'><button type="button" data-sort="project" @onclick='() => SortResults("project")'>Projeto</button></th>
                                <th scope="col" data-column="client" aria-sort='@AriaSort("client")'><button type="button" data-sort="client" @onclick='() => SortResults("client")'>Cliente</button></th>
                                <th scope="col" data-column="dc" aria-sort='@AriaSort("dc")'><button type="button" data-sort="dc" @onclick='() => SortResults("dc")'>DC</button></th>
                                <th scope="col">DM</th>
                                <th scope="col" data-column="responses" aria-sort='@AriaSort("responses")'><button type="button" data-sort="responses" @onclick='() => SortResults("responses")'>Respostas</button></th>
                                <th scope="col" data-column="nps" aria-sort='@AriaSort("nps")'><button type="button" data-sort="nps" @onclick='() => SortResults("nps")'>NPS</button></th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in SortedProjectResults)
                            {
                                <tr class="nps-result-row" data-project-id="@result.Id">
                                    <td class="data-table__cell-strong nps-result-project">
                                        @if (result.Status.Code == "responded")
                                        {
                                            <button type="button"
                                                    class="nps-result-toggle"
                                                    aria-expanded="@((expandedProjectId == result.Id).ToString().ToLowerInvariant())"
                                                    aria-label="@($"{(expandedProjectId == result.Id ? "Recolher" : "Expandir")} respostas de {result.Name}")"
                                                    @onclick="() => ToggleResultExpansionAsync(result)">@result.Name</button>
                                        }
                                        else
                                        {
                                            @result.Name
                                        }
                                    </td>
                                    <td>@(result.Client ?? "—")</td>
                                    <td>@result.Dc</td>
                                    <td>@(result.DeliveryManager ?? "—")</td>
                                    <td>@result.ResponsesCount</td>
                                    <td>@DisplayMetric(result.OfficialNps)</td>
                                    <td><BrqStatusPill Label="@result.Status.Label" Tone="@Tone(result.Status.Tone)" Size="BrqSize.Small" /></td>
                                </tr>
                                @if (expandedProjectId == result.Id)
                                {
                                    <tr class="nps-result-expansion" data-project-id="@result.Id">
                                        <td colspan="7">
                                            @if (expansionLoading)
                                            {
                                                <p role="status">Carregando respostas de @result.Name…</p>
                                            }
                                            else if (expansionError is not null)
                                            {
                                                <div class="nps-expansion-error"><p>@expansionError</p><button type="button" class="btn btn-ghost" @onclick="() => RetryResultExpansionAsync(result)">Tentar novamente</button></div>
                                            }
                                            else
                                            {
                                                <div class="nps-expansion-summary">
                                                    <dl>
                                                        @foreach (var item in result.Distribution)
                                                        {
                                                            <div><dt>@item.Label</dt><dd>@item.Count</dd></div>
                                                        }
                                                        @foreach (var format in result.Formats)
                                                        {
                                                            <div><dt>@format.Label</dt><dd>@format.Count</dd></div>
                                                        }
                                                        <div><dt>Mais recente</dt><dd>@NpsTimeDisplay.DateAndTime(result.LastResponseAt)</dd></div>
                                                    </dl>
                                                    @if (expandedResponses.Count == 0)
                                                    {
                                                        <p>Nenhuma resposta no recorte atual.</p>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var group in GroupedExpandedResponses)
                                                        {
                                                            <section class="nps-expansion-class" data-classification="@group.Key">
                                                                <h3>@group.First().ClassificationLabel</h3>
                                                                <ul>
                                                                    @foreach (var response in group)
                                                                    {
                                                                        <li><strong>@response.Score · @response.FormatLabel</strong><span>@(response.Comment ?? "Sem comentário")</span><time datetime='@response.SubmittedAt.ToString("O")'>@NpsTimeDisplay.DateAndTime(response.SubmittedAt)</time></li>
                                                                    }
                                                                </ul>
                                                            </section>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </BrqTableShell>
                </section>
            }
        }
        else if (ActiveTab == NpsTab.Responses)
        {
            @if (isLoading)
            {
                <p class="nps-loading" role="status">Atualizando respostas…</p>
            }
            @if (loadError is not null)
            {
                <div class="status-card error nps-load-error"><p>@loadError</p><button type="button" class="btn btn-purple" @onclick="ReloadAsync">Tentar novamente</button></div>
            }
            else if (!isLoading && responseAudit.Count == 0)
            {
                <div class="nps-empty-delivery"><BrqEmptyState Title="Nenhuma resposta" Description="Ajuste os filtros ou aguarde uma nova coleta." /></div>
            }
            else
            {
                <section class="nps-responses-table" aria-busy="@isLoading">
                    <BrqTableShell Caption="Auditoria de respostas NPS">
                        <thead>
                            <tr><th scope="col">Projeto</th><th scope="col">Nota</th><th scope="col">Classificação</th><th scope="col">Formato</th><th scope="col">Autor</th><th scope="col">Comentário</th><th scope="col">Recebida</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var response in responseAudit)
                            {
                                <tr class="nps-response-row"
                                    tabindex="0"
                                    aria-label="@($"Abrir resposta de {response.ProjectName}")"
                                    @onclick="() => OpenResponseDialog(response)"
                                    @onkeydown="args => ResponseRowKeyDown(args, response)">
                                    <td class="data-table__cell-strong"><button type="button" class="nps-response-project" @onclick:stopPropagation="true" @onclick="() => OpenResponseDialog(response)">@response.ProjectName</button></td>
                                    <td><strong class="nps-response-score">@response.Score</strong></td>
                                    <td><BrqStatusPill Label="@response.ClassificationLabel" Tone='@Tone(response.Classification == "promoter" ? "positive" : response.Classification == "passive" ? "warning" : "critical")' Size="BrqSize.Small" /></td>
                                    <td>@response.FormatLabel</td>
                                    <td class="nps-response-author"><span>@ResponseAuthorName(response)</span>@if (ResponseAuthorDetail(response) is { } detail) { <small>@detail</small> }</td>
                                    <td><span class="nps-response-comment" title="@response.Comment">@(response.Comment ?? "Sem comentário")</span></td>
                                    <td><time datetime='@response.SubmittedAt.ToString("O")'>@NpsTimeDisplay.DateAndTime(response.SubmittedAt)</time></td>
                                </tr>
                            }
                        </tbody>
                    </BrqTableShell>
                </section>
            }
        }
    </div>
</section>

<BrqDialog @bind-Open="createDialogOpen"
           Title="Gerar link NPS"
           Description="@CreateDialogDescription"
           CssClass="nps-dialog"
           AutofocusSelector=".nps-create-project">
    <ChildContent>
        @if (createdDispatch is null)
        {
            <div class="nps-create-form">
                <div class="nps-dialog-step">
                    <span>1</span>
                    <div><strong>Projeto, formato e idioma</strong><p>Defina como a rodada será compartilhada.</p></div>
                </div>
                <div class="nps-form-grid">
                    <label class="nps-field nps-field-full">
                        <span>Projeto</span>
                        <select class="nps-create-project" @bind="createProjectId">
                            <option value="0">Selecione o projeto</option>
                            @foreach (var project in projects.Where(project => project.Stage.Code != "waived"))
                            {
                                <option value="@project.Id">@project.Name</option>
                            }
                        </select>
                    </label>
                    <label class="nps-field">
                        <span>Formato</span>
                        <select @bind="createFormat"><option value="complete">Completo</option><option value="simplified">Simplificado</option></select>
                    </label>
                    <label class="nps-field">
                        <span>Idioma</span>
                        <select @bind="createLanguage"><option value="pt">Português</option><option value="en">Inglês</option><option value="es">Espanhol</option></select>
                    </label>
                </div>
            </div>
        }
        else
        {
            var target = createdDispatch.Targets.Single(target => target.IsGeneric);
            <div class="nps-created-link">
                <div class="nps-dialog-step complete">
                    <span>2</span>
                    <div><strong>Link pronto · @createdDispatch.Dispatch.FormatLabel</strong><p>Compartilhe o link ou a mensagem sugerida.</p></div>
                </div>
                <label class="nps-created-block">
                    <span>Link</span>
                    <input readonly value="@PublicUrl(target.Token)" />
                </label>
                <div class="nps-created-block nps-created-validity">
                    <span>Validade</span>
                    <strong>@NpsTimeDisplay.Date(createdDispatch.Dispatch.ExpiresAt)</strong>
                </div>
                <label class="nps-created-block">
                    <span>Mensagem sugerida</span>
                    <textarea readonly>@SuggestedMessage</textarea>
                </label>
            </div>
        }

        @if (actionError is not null)
        {
            <p class="nps-action-error" role="alert">@actionError</p>
        }
    </ChildContent>
    <Footer>
        @if (createdDispatch is null)
        {
            <button type="button" class="btn btn-ghost" @onclick="CloseCreateDialog">Cancelar</button>
            <button type="button" class="btn btn-purple nps-create-submit" disabled="@(createProjectId == 0)" @onclick="CreateDispatchAsync">Gerar link</button>
        }
        else
        {
            <button type="button" class="btn btn-ghost" @onclick="() => CopyAsync(PublicUrl(createdDispatch.Targets.Single(target => target.IsGeneric).Token))">Copiar link</button>
            <button type="button" class="btn btn-purple" @onclick="() => CopyAsync(SuggestedMessage)">Copiar mensagem</button>
        }
    </Footer>
</BrqDialog>

<BrqDialog @bind-Open="responseDialogOpen"
           Title="Resposta NPS"
           Description="@selectedResponse?.ProjectName"
           CssClass="nps-dialog nps-response-dialog">
    <ChildContent>
        @if (selectedResponse is not null)
        {
            <section class="nps-response-overview">
                <div><span>Nota</span><strong>@selectedResponse.Score</strong></div>
                <div><span>Classificação</span><strong>@selectedResponse.ClassificationLabel</strong></div>
                <div><span>Formato</span><strong>@selectedResponse.FormatLabel</strong></div>
                <div><span>Recebida</span><strong>@NpsTimeDisplay.DateAndTime(selectedResponse.SubmittedAt)</strong></div>
            </section>
            <section class="nps-response-attribution">
                <h3>Atribuição</h3>
                <strong>@ResponseAuthorName(selectedResponse)</strong>
                @if (ResponseAuthorDetail(selectedResponse) is { } detail)
                {
                    <span>@detail</span>
                }
            </section>
            <section class="nps-response-full-comment">
                <h3>Comentário</h3>
                <p>@(selectedResponse.Comment ?? "Sem comentário")</p>
            </section>
            @if (selectedResponse.Format == "complete")
            {
                <section class="nps-response-aspects">
                    <header><h3>Aspectos</h3><span>Média dos aspectos <strong>@ResponseAspectAverage(selectedResponse)</strong></span></header>
                    <dl>
                        <div class="nps-response-aspect"><dt>Qualidade</dt><dd>@(selectedResponse.Quality?.ToString() ?? "—")</dd></div>
                        <div class="nps-response-aspect"><dt>Prazo</dt><dd>@(selectedResponse.Schedule?.ToString() ?? "—")</dd></div>
                        <div class="nps-response-aspect"><dt>Comunicação</dt><dd>@(selectedResponse.Communication?.ToString() ?? "—")</dd></div>
                        <div class="nps-response-aspect"><dt>Valor para o negócio</dt><dd>@(selectedResponse.BusinessValue?.ToString() ?? "—")</dd></div>
                    </dl>
                </section>
            }
        }
    </ChildContent>
    <Footer><button type="button" class="btn btn-ghost" @onclick="CloseResponseDialog">Fechar</button></Footer>
</BrqDialog>

<BrqDialog @bind-Open="detailDialogOpen" Title="Detalhe da coleta" Description="@selectedDetail?.Project.Name" CssClass="nps-dialog nps-detail-dialog">
    <ChildContent>
        @if (actionError is not null)
        {
            <p class="nps-action-error" role="alert">@actionError</p>
        }

        @if (selectedDetail is not null)
        {
            <section class="nps-detail-kpis" aria-label="Indicadores da coleta">
                <article class="nps-detail-kpi"><span>NPS</span><strong>@DisplayMetric(selectedDetail.OfficialNps)</strong></article>
                <article class="nps-detail-kpi"><span>Respostas</span><strong>@selectedDetail.ResponsesCount</strong></article>
                <article class="nps-detail-kpi"><span>Média</span><strong>@DisplayMetric(selectedDetail.AverageScore)</strong></article>
                <article class="nps-detail-kpi"><span>Promotores</span><strong>@selectedDetail.PromotersCount</strong></article>
            </section>
            <section class="nps-detail-links">
                <h3>Links ativos</h3>
                @if (selectedDetail.ActiveLinks.Count == 0)
                {
                    <p class="nps-detail-empty">Nenhum link ativo.</p>
                }
                else
                {
                    @foreach (var link in selectedDetail.ActiveLinks)
                    {
                        <article>
                            <span><small>Formato</small><strong>@link.FormatLabel</strong></span>
                            <span><small>Status</small><strong>@link.AvailabilityLabel</strong></span>
                            <span><small>Validade</small><strong>@NpsTimeDisplay.Date(link.ExpiresAt)</strong></span>
                        </article>
                    }
                }
            </section>
            <section class="nps-detail-responses">
                <header>
                    <h3>Respostas recentes</h3>
                    <div class="nps-detail-format-filter" aria-label="Filtrar respostas por formato">
                        <button type="button" class="nps-detail-segment @(detailFormat == "all" ? "active" : null)" data-format="all" aria-pressed="@((detailFormat == "all").ToString().ToLowerInvariant())" @onclick="FilterAllDetailResponsesAsync">Todos</button>
                        <button type="button" class="nps-detail-segment @(detailFormat == "complete" ? "active" : null)" data-format="complete" aria-pressed="@((detailFormat == "complete").ToString().ToLowerInvariant())" @onclick="FilterCompleteDetailResponsesAsync">Completo</button>
                        <button type="button" class="nps-detail-segment @(detailFormat == "simplified" ? "active" : null)" data-format="simplified" aria-pressed="@((detailFormat == "simplified").ToString().ToLowerInvariant())" @onclick="FilterSimplifiedDetailResponsesAsync">Simplificado</button>
                    </div>
                </header>
                @if (detailResponses.Count == 0)
                {
                    <p class="nps-detail-empty">Nenhuma resposta neste formato.</p>
                }
                else
                {
                    <ul class="nps-recent-responses">
                        @foreach (var response in detailResponses)
                        {
                            <li><strong>@response.Score · @response.ClassificationLabel</strong><span>@(response.Comment ?? "Sem comentário")</span></li>
                        }
                    </ul>
                }
            </section>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseDetailDialog">Fechar</button>
    </Footer>
</BrqDialog>

<BrqDialog @bind-Open="waiverDialogOpen"
           Title="Dispensar coleta"
           Description="A dispensa é reversível e fecha os links abertos."
           CssClass="nps-dialog"
           AutofocusSelector=".nps-waiver-reason">
    <ChildContent>
        <label class="nps-field">
            <span>Motivo da dispensa</span>
            <textarea class="nps-waiver-reason" @bind="waiverReason" maxlength="500" placeholder="Explique por que este projeto não participará desta coleta"></textarea>
        </label>

        @if (actionError is not null)
        {
            <p class="nps-action-error" role="alert">@actionError</p>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost nps-waiver-cancel" @onclick="CloseWaiverDialog">Cancelar</button>
        <button type="button" class="btn btn-purple nps-waiver-confirm" disabled="@string.IsNullOrWhiteSpace(waiverReason)" @onclick="WaiveAsync">Confirmar dispensa</button>
    </Footer>
</BrqDialog>
