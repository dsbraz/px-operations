@page "/nps"
@page "/nps/coleta"
@page "/nps/resultados"
@page "/nps/respostas"
@using PxOperations.Ui.Components.DataDisplay
@using PxOperations.Ui.Components.Forms
@using PxOperations.Ui.Components.Overlays

<PageTitle>NPS · Operations PX</PageTitle>

<section class="nps-page">
    <header class="nps-page-header">
        <div>
            <h1>NPS</h1>
            <p>Coleta e leitura do relacionamento com clientes.</p>
        </div>
        <div class="nps-page-actions">
            <a class="btn btn-ghost" href="@ExportHref">Exportar CSV</a>
            <button type="button" class="btn btn-purple" @onclick="OpenCreateDialog">Gerar link</button>
        </div>
    </header>

    <nav class="view-tabs" aria-label="Visões do NPS">
        <NavLink class="vtab" href="@TabHref("coleta")" Match="NavLinkMatch.Prefix">Coleta</NavLink>
        <NavLink class="vtab" href="@TabHref("resultados")" Match="NavLinkMatch.Prefix">Resultados</NavLink>
        <NavLink class="vtab" href="@TabHref("respostas")" Match="NavLinkMatch.Prefix">Respostas</NavLink>
    </nav>

    @if (ShowsFilters)
    {
        <div class="nps-filter-toolbar">
            <label class="nps-search">
                <span class="sr-only">Buscar projeto ou cliente</span>
                <input value="@search" @oninput="SearchChanged" placeholder="Buscar projeto ou cliente" />
            </label>
            <BrqFilterPanel ActiveFacetCount="@ActiveFacetCount" OnClear="ClearFiltersAsync">
                <fieldset>
                    <legend>Cliente</legend>
                    @foreach (var option in FilterOptions.Clients)
                    {
                        <label><input type="checkbox" checked="@clients.Contains(option.Code)" @onchange="() => ToggleFacetAsync(clients, option.Code)" />@option.Label</label>
                    }
                </fieldset>
                <fieldset>
                    <legend>DC</legend>
                    @foreach (var option in FilterOptions.Dcs)
                    {
                        <label><input type="checkbox" checked="@dcs.Contains(option.Code)" @onchange="() => ToggleFacetAsync(dcs, option.Code)" />@option.Label</label>
                    }
                </fieldset>
                <fieldset>
                    <legend>Tipo</legend>
                    @foreach (var option in FilterOptions.ProjectTypes)
                    {
                        <label><input type="checkbox" checked="@projectTypes.Contains(option.Code)" @onchange="() => ToggleFacetAsync(projectTypes, option.Code)" />@option.Label</label>
                    }
                </fieldset>
                <fieldset>
                    <legend>Delivery Manager</legend>
                    @foreach (var option in FilterOptions.DeliveryManagers)
                    {
                        <label><input type="checkbox" checked="@deliveryManagers.Contains(option.Code)" @onchange="() => ToggleFacetAsync(deliveryManagers, option.Code)" />@option.Label</label>
                    }
                </fieldset>
                @if (ActiveTab == NpsTab.Collection)
                {
                    <fieldset>
                        <legend>Dispensados</legend>
                        <label><input type="checkbox" checked="@includeWaived" @onchange="ToggleWaivedAsync" />Mostrar dispensados</label>
                    </fieldset>
                }
                @if (ActiveTab == NpsTab.Results)
                {
                    <fieldset>
                        <legend>Status</legend>
                        @foreach (var option in FilterOptions.Statuses)
                        {
                            <label><input type="checkbox" checked="@statuses.Contains(option.Code)" @onchange="() => ToggleFacetAsync(statuses, option.Code)" />@option.Label</label>
                        }
                    </fieldset>
                    <fieldset>
                        <legend>Data da coleta</legend>
                        <label>De <input type="date" value="@from" @onchange="FromChangedAsync" /></label>
                        <label>Até <input type="date" value="@to" @onchange="ToChangedAsync" /></label>
                    </fieldset>
                }
            </BrqFilterPanel>
        </div>

        @if (ActiveChips.Count != 0)
        {
            <div class="nps-filter-chips">
                @foreach (var chip in ActiveChips)
                {
                    <button type="button" class="nps-filter-chip" @onclick="() => RemoveFacetAsync(chip.Key)">
                        <strong>@chip.Label:</strong> @chip.Values <span aria-hidden="true">×</span>
                    </button>
                }
            </div>
        }
    }

    @if (ActiveTab == NpsTab.Collection)
    {
        @if (loadError is not null)
        {
            <div class="status-card error nps-load-error">
                <p>@loadError</p>
                <button type="button" class="btn btn-purple" @onclick="ReloadAsync">Tentar novamente</button>
            </div>
        }

        <div class="nps-board" aria-busy="@isLoading">
            @foreach (var column in BoardColumns)
            {
                <section class="nps-board-column" data-stage="@column.Code">
                    <header><h2>@column.Label</h2><span>@ProjectsForStage(column.Code).Count</span></header>
                    <div class="nps-card-list">
                        @foreach (var project in ProjectsForStage(column.Code))
                        {
                            <article class="nps-project-card">
                                <div class="nps-card-heading">
                                    <div><h3>@project.Name</h3><p>@project.Client · @project.Dc</p></div>
                                    <BrqStatusPill Label="@project.Stage.Label" Tone="@Tone(project.Stage.Tone)" Size="BrqSize.Small" />
                                </div>
                                <dl>
                                    <div><dt>DM</dt><dd>@(project.DeliveryManager ?? "—")</dd></div>
                                    <div><dt>Respostas</dt><dd>@project.ResponsesCount</dd></div>
                                </dl>
                                <BrqStatusPill Label="@project.Temporal.Label" Tone="@Tone(project.Temporal.Tone)" Size="BrqSize.Small" />
                                @if (project.ActiveLinks.Count != 0)
                                {
                                    <ul class="nps-card-links">
                                        @foreach (var link in project.ActiveLinks)
                                        {
                                            <li><strong>@link.FormatLabel</strong><span>@link.AvailabilityLabel · @link.ExpiresAt.ToString("dd/MM/yyyy")</span></li>
                                        }
                                    </ul>
                                }
                                <div class="nps-card-actions">
                                    @if (project.PrimaryAction is not null)
                                    {
                                        <button type="button" class="btn btn-purple" @onclick="() => RunPrimaryActionAsync(project)">@project.PrimaryAction.Label</button>
                                    }
                                    <button type="button" class="btn btn-ghost" @onclick="() => OpenDetailAsync(project.Id)">Detalhe</button>
                                    <button type="button" class="btn btn-ghost" @onclick="() => OpenWaiverDialog(project.Id)">Dispensar</button>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        @if (includeWaived)
        {
            <section class="nps-waived-section">
                <h2>Dispensados</h2>
                <div class="nps-waived-grid">
                    @foreach (var project in WaivedProjects)
                    {
                        <article class="nps-project-card">
                            <h3>@project.Name</h3>
                            <p>@project.Waiver?.Reason</p>
                            <BrqStatusPill Label="@project.Temporal.Label" Tone="BrqStatusTone.Neutral" Size="BrqSize.Small" />
                            <button type="button" class="btn btn-purple" @onclick="() => ReactivateAsync(project.Id)">Reativar</button>
                        </article>
                    }
                </div>
            </section>
        }
    }
    else if (ActiveTab == NpsTab.Results)
    {
        @if (loadError is not null)
        {
            <div class="status-card error nps-load-error"><p>@loadError</p><button class="btn btn-purple" @onclick="ReloadAsync">Tentar novamente</button></div>
        }
        else if (dashboard is not null)
        {
            <section class="nps-results" aria-busy="@isLoading">
                <div class="nps-kpis">
                    <article class="nps-kpi"><strong>@DisplayMetric(dashboard.OfficialNps)</strong><span>NPS oficial</span></article>
                    <article class="nps-kpi"><strong>@dashboard.TotalResponses</strong><span>Respostas</span></article>
                    <article class="nps-kpi"><strong>@DisplayMetric(dashboard.AverageScore)</strong><span>Score médio</span></article>
                    <article class="nps-kpi"><strong>@dashboard.OverdueProjects</strong><span>Vencidos</span></article>
                </div>
                <p class="nps-formula">NPS = % promotores − % detratores</p>
                <div class="nps-distribution-bar" aria-label="Distribuição das classificações">
                    @foreach (var item in dashboard.Distribution)
                    {
                        <span class="@($"tone-{item.Tone}")" style="@($"width:{item.Percentage}%")"></span>
                    }
                </div>
                <ul class="nps-distribution-legend">
                    @foreach (var item in dashboard.Distribution)
                    {
                        <li><strong>@item.Label</strong><span>@item.Count · @item.Percentage.ToString("0.0")%</span></li>
                    }
                </ul>
            </section>
        }
    }
    else if (ActiveTab == NpsTab.Responses)
    {
        <p class="nps-next-delivery">A tabela de auditoria chega numa entrega seguinte.</p>
    }
</section>

<BrqDialog @bind-Open="createDialogOpen" Title="Gerar link NPS" Description="@CreateDialogDescription">
    @if (createdDispatch is null)
    {
        <div class="nps-create-form">
            <p><strong>1.</strong> Projeto, formato e idioma</p>
            <select class="nps-create-project" @bind="createProjectId">
                <option value="0">Selecione o projeto</option>
                @foreach (var project in projects.Where(project => project.Stage.Code != "waived"))
                {
                    <option value="@project.Id">@project.Name</option>
                }
            </select>
            <select @bind="createFormat"><option value="complete">Completo</option><option value="simplified">Simplificado</option></select>
            <select @bind="createLanguage"><option value="pt">Português</option><option value="en">Inglês</option><option value="es">Espanhol</option></select>
            <button type="button" class="btn btn-purple nps-create-submit" disabled="@(createProjectId == 0)" @onclick="CreateDispatchAsync">Gerar link</button>
        </div>
    }
    else
    {
        var target = createdDispatch.Targets.Single(target => target.IsGeneric);
        <div class="nps-created-link">
            <p><strong>2.</strong> Link pronto · @createdDispatch.Dispatch.FormatLabel</p>
            <input readonly value="@PublicUrl(target.Token)" />
            <p>Expira em <strong>@createdDispatch.Dispatch.ExpiresAt.ToString("dd/MM/yyyy")</strong></p>
            <textarea readonly>@SuggestedMessage</textarea>
            <div><button class="btn btn-ghost" @onclick="() => CopyAsync(PublicUrl(target.Token))">Copiar link</button><button class="btn btn-purple" @onclick="() => CopyAsync(SuggestedMessage)">Copiar mensagem</button></div>
        </div>
    }
</BrqDialog>

<BrqDialog @bind-Open="detailDialogOpen" Title="Detalhe da coleta" Description="@selectedDetail?.Project.Name">
    @if (selectedDetail is not null)
    {
        <div class="nps-detail-kpis"><span>NPS <strong>@DisplayMetric(selectedDetail.OfficialNps)</strong></span><span>Respostas <strong>@selectedDetail.ResponsesCount</strong></span><span>Média <strong>@DisplayMetric(selectedDetail.AverageScore)</strong></span><span>Promotores <strong>@selectedDetail.PromotersCount</strong></span></div>
        <div class="nps-detail-links">
            @foreach (var link in selectedDetail.ActiveLinks)
            {
                <p><strong>@link.FormatLabel</strong> · @link.AvailabilityLabel · @link.ExpiresAt.ToString("dd/MM/yyyy")</p>
            }
        </div>
        <div class="nps-detail-format-filter"><button @onclick="FilterAllDetailResponsesAsync">Todos</button><button @onclick="FilterCompleteDetailResponsesAsync">Completo</button><button @onclick="FilterSimplifiedDetailResponsesAsync">Simplificado</button></div>
        <ul class="nps-recent-responses">@foreach (var response in detailResponses){<li><strong>@response.Score · @response.ClassificationLabel</strong><span>@response.Comment</span></li>}</ul>
    }
</BrqDialog>

<BrqDialog @bind-Open="waiverDialogOpen" Title="Dispensar coleta" Description="A dispensa é reversível e fecha os links abertos.">
    <textarea @bind="waiverReason" maxlength="500" placeholder="Motivo da dispensa"></textarea>
    <button class="btn btn-purple" disabled="@string.IsNullOrWhiteSpace(waiverReason)" @onclick="WaiveAsync">Confirmar dispensa</button>
</BrqDialog>
