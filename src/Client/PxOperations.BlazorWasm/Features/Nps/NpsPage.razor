@page "/nps"
@page "/nps/{Tab}"
@using PxOperations.BlazorWasm.Api
@using PxOperations.BlazorWasm.Features.Nps.Components
@using PxOperations.Ui.Components.Forms
@using PxOperations.Ui.Components.Navigation
@using PxOperations.Ui.Components.DataDisplay

<PageTitle>NPS · Operations PX</PageTitle>

<BrqPageHeader Title="NPS">
    <Actions>
        <a class="brq-button brq-button--secondary brq-button--sm" href="@ExportHref">
            <span aria-hidden="true">&#8595;</span> Exportar CSV
        </a>
        <button type="button" class="brq-button brq-button--primary brq-button--sm" @onclick="OpenCreateLinkModal">
            Gerar link
        </button>
    </Actions>
</BrqPageHeader>

<NpsTabs Tabs="@TabDefinitions" Active="@ActiveTab" Count="@PortfolioCount" />

<NpsFilterBar Search="@filterSearch"
              SearchChanged="OnSearchChanged"
              Chips="@FilterChips"
              OnRemoveChip="RemoveChip"
              OnClearAll="ClearFilters"
              Count="@PortfolioCount">
    <FacetContent>
        @* D11: checkbox, não radio — marcar dois valores da mesma faceta filtra
           pela união deles, e o painel segue aberto para marcar vários. *@
        @if (filterOptions is { Companies.Count: > 0 })
        {
            <fieldset>
                <legend>Empresa</legend>
                @foreach (var company in filterOptions.Companies)
                {
                    <label>
                        <input type="checkbox" checked="@filterCompanies.Contains(company)" @onchange="@(args => ToggleCompany(company, args))" />
                        <span>@company</span>
                    </label>
                }
            </fieldset>
        }
        <fieldset>
            <legend>Delivery Center</legend>
            @foreach (var dc in DcOptions)
            {
                <label>
                    <input type="checkbox" checked="@filterDcs.Contains(dc)" @onchange="@(args => ToggleDc(dc, args))" />
                    <span>@dc</span>
                </label>
            }
        </fieldset>
        <fieldset>
            <legend>Tipo de projeto</legend>
            @foreach (var type in ProjectTypeOptions)
            {
                <label>
                    <input type="checkbox" checked="@filterProjectTypes.Contains(type)" @onchange="@(args => ToggleProjectType(type, args))" />
                    <span>@type</span>
                </label>
            }
        </fieldset>
        @if (filterOptions is { DeliveryManagers.Count: > 0 })
        {
            <fieldset>
                <legend>Delivery Manager</legend>
                @foreach (var dm in filterOptions.DeliveryManagers)
                {
                    <label>
                        <input type="checkbox" checked="@filterDeliveryManagers.Contains(dm)" @onchange="@(args => ToggleDeliveryManager(dm, args))" />
                        <span>@dm</span>
                    </label>
                }
            </fieldset>
        }
        @if (OffersStatusFacet)
        {
            <fieldset>
                <legend>Status NPS</legend>
                @foreach (var status in StatusOptions)
                {
                    <label>
                        <input type="checkbox" checked="@filterStatuses.Contains(status)" @onchange="@(args => ToggleStatus(status, args))" />
                        <span>@status</span>
                    </label>
                }
            </fieldset>
        }
        @if (OffersResponseFacets)
        {
            @* F10: formato e classificação são facetas de RESPOSTA — nas outras
               abas, que listam projetos, não teriam o que recortar. *@
            <fieldset>
                <legend>Formato</legend>
                @foreach (var format in FormatOptions)
                {
                    <label>
                        <input type="checkbox" checked="@filterFormats.Contains(format)" @onchange="@(args => ToggleFormat(format, args))" />
                        <span>@format</span>
                    </label>
                }
            </fieldset>
            <fieldset>
                <legend>Classificação</legend>
                @foreach (var classification in ClassificationOptions)
                {
                    <label>
                        <input type="checkbox" checked="@filterClassifications.Contains(classification)" @onchange="@(args => ToggleClassification(classification, args))" />
                        <span>@classification</span>
                    </label>
                }
            </fieldset>
        }
        @if (OffersDateFacet)
        {
            @* F1: a régua é a data da RESPOSTA, então a faceta não aparece na
               Coleta — lá esvaziaria as colunas de quem ainda não respondeu. *@
            <fieldset>
                <legend>Data de coleta</legend>
                @foreach (var period in PeriodOptions)
                {
                    <label>
                        <input type="radio" name="nps-periodo" checked="@(filterPeriod == period.Value)" @onclick="@(() => SelectPeriod(period.Value))" />
                        <span>@period.Label</span>
                    </label>
                }
            </fieldset>
        }
        @if (ActiveTab == TabCollection)
        {
            @* F1: "coletas dispensadas" é toggle Ocultar/Mostrar, não faceta de
               lista — e só faz sentido no quadro, que é de onde elas somem. *@
            <fieldset>
                <legend>Coletas dispensadas</legend>
                <label>
                    <input type="checkbox" checked="@includeDismissed" @onchange="ToggleDismissed" />
                    <span>Mostrar dispensados</span>
                </label>
            </fieldset>
        }
    </FacetContent>
</NpsFilterBar>

@if (isLoading)
{
    <div style="text-align:center;padding:60px;color:var(--muted)">Carregando...</div>
}
else if (loadError is not null)
{
    <div class="status-card error nps-error">
        <p>@loadError</p>
        <button class="btn btn-purple" @onclick="RefreshAsync">Tentar novamente</button>
    </div>
}
else
{
    <main class="nps-layout nps-layout-wide">
        @* F7 vive na aba Resultados, como no protótipo, e não numa faixa no
           topo da página. Coleta (F2) e Respostas (F10) chegam nas entregas
           seguintes; até lá anunciam o que serão em vez de renderizar nada. *@
        @if (ActiveTab == TabResults)
        {
        @* F7: leitura executiva. Os quatro KPIs do PRD, com a fórmula do NPS à
           vista na distribuição. Sem subtexto de taxa de resposta: D2 aposentou
           o "% de enviados" porque link compartilhado não tem denominador. *@
        <BrqKpiBar>
            <BrqKpiCard Label="NPS oficial"
                        Value="@(dashboard?.OfficialNps.ToString("0.0") ?? "—")"
                        Context="% promotores − % detratores"
                        DataTestId="nps-official" />
            <BrqKpiCard Label="Respostas"
                        Value="@(dashboard?.TotalResponses.ToString() ?? "—")" />
            <BrqKpiCard Label="Score médio"
                        Value="@(dashboard?.AverageScore.ToString("0.0") ?? "—")"
                        Context="média das notas (1 a 10)" />
            <BrqKpiCard Label="Projetos vencidos"
                        Value="@(dashboard?.OverdueProjects.ToString() ?? "—")"
                        Context="sem resposta há 90+ dias" />
        </BrqKpiBar>

        <NpsDistribution Detractors="@(dashboard?.Detractors ?? 0)"
                         Passives="@(dashboard?.Passives ?? 0)"
                         Promoters="@(dashboard?.Promoters ?? 0)"
                         OfficialNps="@(dashboard?.OfficialNps ?? 0)" />

        @if (dashboard is not null)
        {
            <NpsAspectAverages Dashboard="@dashboard" />
        }

        <NpsProjectsTable Projects="@projects"
                          OnGenerateLink="OpenCreateLinkModal"
                          OnOpenDetail="OpenProjectDetailAsync"
                          LoadResponses="LoadProjectResponsesAsync" />
        }

        @if (ActiveTab == TabCollection)
        {
            @* F2: faixa de KPIs no topo do quadro, para contexto. *@
            <BrqKpiBar>
                <BrqKpiCard Label="Projetos" Value="@projects.Count.ToString()" />
                <BrqKpiCard Label="Projetos vencidos"
                            Value="@(dashboard?.OverdueProjects.ToString() ?? "—")"
                            Context="sem resposta há 90+ dias" />
                <BrqKpiCard Label="Links ativos"
                            Value="@(dashboard?.ActiveDispatches.ToString() ?? "—")" />
                <BrqKpiCard Label="Respostas"
                            Value="@(dashboard?.TotalResponses.ToString() ?? "—")" />
            </BrqKpiBar>

            <NpsCollectionBoard Projects="@projects"
                                OnGenerateLink="OpenCreateLinkModal"
                                OnReactivate="ReactivateCollectionAsync"
                                OnDismiss="StartDismissAsync"
                                OnOpenDetail="OpenProjectDetailAsync" />
        }

        @if (ActiveTab == TabResponses)
        {
            <NpsResponsesTable Responses="@responses" OnOpen="OpenResponseDetail" />
        }
    </main>
}

@if (operationError is not null)
{
    <div class="toast show"><span style="color:var(--red);font-size:14px">!</span><span>@operationError</span></div>
}

@if (dismissTarget is not null)
{
    <NpsDismissDialog Project="@dismissTarget"
                      OnCancel="CancelDismiss"
                      OnConfirm="ConfirmDismissAsync" />
}

@if (showCreateLinkModal)
{
    <NpsCreateLinkModal Projects="@projects"
                        SelectedProjectId="@selectedProjectId"
                        SelectedProjectIdChanged="OnCreateLinkProjectChanged"
                        SelectedDetail="@selectedDetail"
                        Created="@createdDispatch"
                        OnCreate="CreateDispatchAsync"
                        OnClose="CloseCreateLinkModal"
                        OnCopyFailed="@(message => operationError = message)"
                        PublicFormUrl="@BuildPublicFormUrl" />
}

@if (selectedResponse is not null)
{
    <NpsResponseDetail Response="@selectedResponse" OnClose="CloseResponseDetail" />
}

@if (showDetailModal && selectedDetail is not null)
{
    <NpsCollectionDetail Detail="@selectedDetail"
                         OnClose="CloseDetailModal"
                         OnGenerateLink="OpenCreateLinkModal"
                         OnCopyLink="CopyDispatchLinkAsync" />
}

