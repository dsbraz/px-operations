@page "/nps/{Token:guid}"
@layout PublicLayout
@using PxOperations.BlazorWasm.Api

<PageTitle>Pesquisa de NPS · BRQ</PageTitle>

<article class="card-survey">
    @if (isLoading)
    {
        <p class="state">@T.Loading</p>
    }
    else if (loadError is not null)
    {
        <h1 class="heading-xl">@T.ErrorTitle</h1>
        <p class="state">@T.ErrorText</p>
    }
    else if (survey is null)
    {
        <h1 class="heading-xl">@T.ErrorTitle</h1>
        <p class="state">@T.ErrorText</p>
    }
    else if (submitted)
    {
        @* O recibo fecha o fluxo: quem respondeu precisa saber que chegou, e
           saber que o link segue valendo para o resto do time (D1). *@
        <h1 class="heading-xl">@T.SentTitle</h1>
        <p class="state">@T.SentText</p>
        <p class="state">@(Identified ? T.SentPrivacyNamed : T.SentPrivacyAnon)</p>
        <p class="state">@T.SentShare</p>
        <p class="state">@T.SentClose</p>
    }
    else if (survey.IsExpired)
    {
        @* D7: passado o prazo, o questionário dá lugar ao aviso. Não adianta
           deixar responder para rejeitar no envio. *@
        <h1 class="heading-xl">@T.ClosedTitle</h1>
        <p class="state">@T.ClosedText</p>
    }
    else if (survey.IsClosed)
    {
        <h1 class="heading-xl">@T.ClosedTitle</h1>
        <p class="state">@T.ClosedText</p>
    }
    else if (survey.AlreadyAnswered)
    {
        <p class="state">@T.AlreadyAnswered</p>
    }
    else
    {
        <header class="intro">
            <p class="intro__meta">@T.Eyebrow</p>
            <h1 class="intro__project heading-xl">@T.Title</h1>
            <p class="intro__meta">@survey.ProjectName · @T.MetaTime · @T.MetaAnon</p>
            @if (Deadline is not null)
            {
                @* D7: o respondente vê até quando a pesquisa fica aberta. *@
                <p class="intro__meta intro__deadline">@Deadline</p>
            }
        </header>

        <section class="q">
            <div class="q__head">
                <h2>@T.Q1</h2>
                <p class="q__hint">@T.Q1Hint</p>
            </div>
            <div class="scale" role="radiogroup" aria-label="@T.Q1">
                @for (var i = 1; i <= 10; i++)
                {
                    var value = i;
                    <button type="button"
                            class="scale__opt @(score == value ? "is-selected" : "")"
                            role="radio"
                            aria-checked="@((score == value).ToString().ToLowerInvariant())"
                            aria-label="@T.ScoreOption(value, 10)"
                            @onclick="() => ChooseScore(value)">@value</button>
                }
            </div>
            <p class="scale__ends"><span>@T.ScaleLow</span><span>@T.ScaleHigh</span></p>
        </section>

        @if (survey.Format == "Completo")
        {
            <section class="q dims">
                <div class="q__head">
                    <h2>@T.Q2</h2>
                    <p class="q__hint">@T.Q2Hint</p>
                </div>
                <p class="dims__legend">@T.DimsLegend</p>

                @foreach (var dim in Dimensions)
                {
                    <div class="dim">
                        <p class="dim__label">@dim.Label</p>
                        <p class="dim__hint">@dim.Hint</p>
                        <div class="scale scale--sm" role="radiogroup" aria-label="@dim.Label">
                            @for (var i = 1; i <= 5; i++)
                            {
                                var value = i;
                                <button type="button"
                                        class="scale__opt @(dim.Value() == value ? "is-selected" : "")"
                                        role="radio"
                                        aria-checked="@((dim.Value() == value).ToString().ToLowerInvariant())"
                                        aria-label="@T.ScoreOption(value, 5)"
                                        @onclick="() => dim.Set(value)">@value</button>
                            }
                        </div>
                    </div>
                }
            </section>
        }

        <section class="q">
            <div class="q__head">
                <h2>@T.Q3</h2>
                <p class="q__hint">@T.Q3Hint</p>
            </div>
            <div class="field">
                <label class="field__label" for="nps-comment">@T.CommentLabel</label>
                <textarea id="nps-comment" class="field__control" rows="4"
                          placeholder="@T.CommentPlaceholder" @bind="comment"></textarea>
            </div>
        </section>

        <section class="q ident">
            <div class="q__head">
                <p class="q__eyebrow">@T.OptionalEyebrow</p>
                <h2>@T.IdentTitle</h2>
                <p class="q__hint">@T.IdentHint</p>
            </div>
            <div class="ident__fields">
                <div class="field">
                    <label class="field__label" for="nps-name">@T.NameLabel</label>
                    <input id="nps-name" class="field__control" placeholder="@T.NamePlaceholder" @bind="respondentName" />
                </div>
                <div class="field">
                    <label class="field__label" for="nps-email">@T.EmailLabel</label>
                    <input id="nps-email" class="field__control" type="email" @bind="respondentEmail" />
                </div>
            </div>
        </section>

        @if (submitError is not null)
        {
            <p class="q__error" role="alert">@submitError</p>
        }

        <div class="next">
            <button type="button" class="brq-button brq-button--primary" @onclick="SubmitAsync">@T.Submit</button>
        </div>

        <p class="foot">@T.FootPrivacy</p>
    }
</article>
