@page "/nps/{Token:guid}"
@using PxOperations.Ui.Components.Navigation

<PageTitle>NPS · Operations PX</PageTitle>

<main class="nps-public-page">
    <header class="nps-public-header">
        <strong class="nps-public-brand">BRQ</strong>
        <BrqThemeToggle />
    </header>

    @if (isLoading)
    {
        <section class="nps-public-card"><p>@Texts.Loading</p></section>
    }
    else if (invalidToken)
    {
        <section class="nps-public-card nps-final-state"><h1>@Texts.InvalidTitle</h1><p>@Texts.InvalidMessage</p></section>
    }
    else if (submitted)
    {
        <section class="nps-public-card nps-final-state"><h1>@Texts.SuccessTitle</h1><p>@Texts.SuccessMessage</p></section>
    }
    else if (survey is not null && survey.Availability != "open")
    {
        <section class="nps-public-card nps-final-state"><h1>@FinalTitle</h1><p>@FinalMessage</p></section>
    }
    else if (survey is not null)
    {
        <section class="nps-public-card">
            <div class="nps-public-intro">
                <span>@Texts.Introduction</span>
                <h1>@survey.ProjectName</h1>
                <p>@survey.Client · @Texts.ValidUntil @survey.ExpiresAt.ToString("dd/MM/yyyy")</p>
            </div>

            <fieldset class="nps-question-block">
                <legend>@Texts.Question</legend>
                <div class="nps-score-scale" role="radiogroup" aria-label="@Texts.Question">
                    @foreach (var value in ScoreValues)
                    {
                        <button type="button" class="@(score == value ? "selected" : null)" aria-pressed="@(score == value)" @onclick="() => score = value">@value</button>
                    }
                </div>
                <div class="nps-scale-help"><span>@Texts.Unlikely</span><span>@Texts.Likely</span></div>
            </fieldset>

            <label class="nps-field">
                <span>@Texts.Comment</span>
                <textarea @bind="comment" maxlength="2000"></textarea>
            </label>

            @if (survey.Format == "complete")
            {
                <section class="nps-aspects">
                    @foreach (var aspect in survey.Aspects)
                    {
                        <fieldset class="nps-aspect">
                            <legend>@aspect.Label</legend>
                            <div class="nps-aspect-scale" role="radiogroup" aria-label="@aspect.Label">
                                @for (var value = aspect.Scale.Minimum; value <= aspect.Scale.Maximum; value++)
                                {
                                    var choice = value;
                                    <button type="button" class="@(AspectValue(aspect.Code) == choice ? "selected" : null)" @onclick="() => SetAspect(aspect.Code, choice)">@choice</button>
                                }
                            </div>
                        </fieldset>
                    }
                </section>
            }

            <section class="nps-identity">
                <label class="nps-field"><span>@Texts.Name</span><input @bind="respondentName" maxlength="200" /></label>
                <label class="nps-field"><span>@Texts.Email</span><input type="email" @bind="respondentEmail" maxlength="320" /></label>
            </section>

            <section class="nps-privacy"><h2>@Texts.PrivacyTitle</h2><p>@Texts.PrivacyMessage</p></section>

            @if (submitError is not null)
            {
                <p class="nps-submit-error" role="alert">@submitError</p>
            }
            <button type="button" class="btn btn-purple nps-submit" disabled="@(!score.HasValue || isSubmitting)" @onclick="SubmitAsync">@Texts.Submit</button>
        </section>
    }
</main>
