server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        include /etc/nginx/security-headers.conf;
        proxy_pass ${PX_OPERATIONS_API_BASE_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
    }

    location /health/ {
        include /etc/nginx/security-headers.conf;
        proxy_pass ${PX_OPERATIONS_API_BASE_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ /index.html;
    }

    # Excecao dentro do _framework: o loader publicado faz import("./dotnet.js"),
    # um caminho sem hash, e por isso o Dockerfile copia dotnet.<hash>.js para
    # dotnet.js. Esse arquivo carrega a lista de assets fingerprinted, entao um
    # ano de cache nele congela o manifest: no deploy seguinte o .wasm antigo
    # deixa de existir, o navegador que voltou pede o nome velho, recebe 404 do
    # try_files e a aplicacao nao sobe. O nome e estavel, logo ele revalida.
    location = /_framework/dotnet.js {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    # Cache imutavel exige que a URL mude quando o conteudo muda. No _framework o
    # pipeline do .NET grava o hash no nome do arquivo (blazor.webassembly.<hash>.js,
    # dotnet.<hash>.js, cada .wasm), entao um ano de cache sem revalidacao e seguro
    # para tudo que passa por aqui - a excecao de nome estavel esta tratada acima.
    location ^~ /_framework/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Os demais estaticos tem nome estavel: app.css, foundation.css da RCL, o
    # bundle de CSS isolation, imagens. Marca-los como immutable prendia o
    # navegador na copia antiga por ate um ano, entao uma alteracao de CSS podia
    # nunca chegar a quem ja tinha visitado. Aqui eles revalidam; o ETag do nginx
    # responde 304 quando nada mudou, entao o custo e um round-trip, nao o corpo.
    location ~* ^/(?:css|images|lib|_content)/|\.styles\.css$ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri =404;
    }
}
