<div class="tabs" role="tablist" aria-label="@AccessibleName">
    @foreach (var item in Items)
    {
        var selected = item.Key == SelectedKey;
        @if (item.Href is null)
        {
            <button type="button"
                    class="tab"
                    role="tab"
                    aria-selected="@(selected ? "true" : "false")"
                    @onclick="() => OnSelect.InvokeAsync(item.Key)">@item.Label</button>
        }
        else
        {
            <a class="tab"
               role="tab"
               href="@item.Href"
               aria-selected="@(selected ? "true" : "false")"
               @onclick="() => OnSelect.InvokeAsync(item.Key)"
               @onclick:preventDefault="@OnSelect.HasDelegate">@item.Label</a>
        }
    }
</div>

@code {
    [Parameter] public string AccessibleName { get; set; } = "Visões";
    [Parameter, EditorRequired] public IReadOnlyList<BrqTabItem> Items { get; set; } = [];
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
}
